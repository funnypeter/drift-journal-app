# Runtime bindings (D1 `DB`, R2 `PHOTOS`, `EMAIL`) and plain vars live in
# wrangler.jsonc. Secrets go in .dev.vars locally and `wrangler secret put` in prod.

# Gemini AI — server-side secret
GEMINI_API_KEY=your_gemini_api_key

# Encrypts stored Garmin tokens. Must equal the old SUPABASE_SERVICE_ROLE_KEY so
# connections made before the Cloudflare move still decrypt.
GARMIN_TOKEN_KEY=your_garmin_token_key

# Mapbox — public key, inlined into the client bundle at build time
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token
