{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drift-journal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "driftjournal.pmansour.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drift-journal",
      "database_id": "7582a95f-cb53-4ac0-a615-b270807cb162",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "drift-journal-photos" }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://driftjournal.pmansour.com",
    "PHOTOS_PUBLIC_URL": "https://driftjournal.pmansour.com/photos",
    "EMAIL_FROM": "noreply@driftjournal.pmansour.com"
  },
  "observability": { "enabled": true }
}
